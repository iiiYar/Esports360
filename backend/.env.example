COMPOSE_PROJECT_NAME=esports360

API_PORT=8010
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

POSTGRES_DB=esports360
POSTGRES_USER=esports360
POSTGRES_PASSWORD=change_me_for_server

DATABASE_URL=postgresql+psycopg://esports360:change_me_for_server@postgres:5432/esports360
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change_me_to_a_long_random_secret

PANDASCORE_TOKEN=
PANDASCORE_SYNC_ENABLED=false
PANDASCORE_SYNC_ON_START=false
PANDASCORE_TODAY_INTERVAL_SECONDS=300
PANDASCORE_LIVE_INTERVAL_SECONDS=60
PANDASCORE_UPCOMING_INTERVAL_SECONDS=900
PANDASCORE_UPCOMING_DAYS=7
PANDASCORE_ROSTER_INTERVAL_HOURS=12
PANDASCORE_ROSTER_TEAM_LIMIT=10
PANDASCORE_PRIORITY_TEAM_IDS=133868,138068,130861,129571,126061,128538,136396,135125,137057,135679
APP_TIMEZONE=Asia/Riyadh

MEDIA_STORAGE_DIR=/data/media
MEDIA_PUBLIC_BASE_URL=/media
OBJECT_STORAGE_DRIVER=minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=esports360-media
S3_ACCESS_KEY=change_me_minio_user
S3_SECRET_KEY=change_me_minio_password
S3_SECURE=false
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9011
IMAGE_BACKFILL_ON_START=false
IMAGE_BACKFILL_FORCE=false
IMAGE_BACKFILL_INTERVAL_HOURS=24
IMAGE_BACKFILL_LIMIT=500

# HLTV detail enrichment (CS2 optional round scores scraper)
CS2_HLTV_DETAIL_ENABLED=true
CS2_HLTV_COMPLETED_DETAIL_LIMIT=3
